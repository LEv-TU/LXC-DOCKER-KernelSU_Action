# ============================================
# 内核源码地址（使用 LineageOS 官方内核）
# ============================================
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8150.git

# ============================================
# 内核源码分支（先试 lineage-23.2，如果不存在就改 main）
# ============================================
KERNEL_SOURCE_BRANCH=lineage-23.2

# ============================================
# 内核编译配置（一加7 Pro 的 defconfig）
# ============================================
KERNEL_CONFIG=vendor/sm8150-perf_defconfig

# ============================================
# 打包文件名（自定义，支持英文数字）
# ============================================
KERNEL_ZIP_NAME=guacamole_lxc_ksu

# ============================================
# 是否开启 KVM（用不到，保持 false）
# ============================================
ENABLE_KVM=false

# ============================================
# 是否开启 LXC/Docker（你需要容器功能，必须 true）
# ============================================
ENABLE_LXC_DOCKER=true

# ============================================
# 内核镜像文件名（一加7 Pro 通常用 Image.gz-dtb）
# ============================================
KERNEL_IMAGE_NAME=Image.gz-dtb

# ============================================
# 是否需要 LLVM=1 LLVM_IAS=1（LineageOS 内核需要，填 y）
# ============================================
LLVM_CONFIG=y

# ============================================
# 是否需要切换 Python2（不需要，false）
# ============================================
SWITCH_PYTHON=false

# ============================================
# 是否需要 dtbo（一般不需要，false）
# ============================================
NEED_DTBO=false

# ============================================
# 是否开启 KernelSU（你需要内核级 root，必须 true）
# ============================================
ENABLE_KERNELSU=true
KERNELSU_TAG=main

# ============================================
# 额外内核配置（追加你需要的所有 CONFIG_*）
# ============================================

EXTRA_CMDS="CONFIG_NAMESPACES=y CONFIG_PID_NS=y CONFIG_IPC_NS=y CONFIG_USER_NS=y CONFIG_UTS_NS=y CONFIG_NET_NS=y CONFIG_CGROUPS=y CONFIG_CGROUP_DEVICE=y CONFIG_CGROUP_PIDS=y CONFIG_MEMCG=y CONFIG_CGROUP_SCHED=y CONFIG_FAIR_GROUP_SCHED=y CONFIG_CGROUP_FREEZER=y CONFIG_CGROUP_NET_PRIO=y CONFIG_CPUSETS=y CONFIG_OVERLAY_FS=y CONFIG_FUSE_FS=y CONFIG_FUSE_DAX=y CONFIG_SECCOMP=y CONFIG_SECCOMP_FILTER=y CONFIG_DEVTMPFS=y CONFIG_TMPFS_POSIX_ACL=y CONFIG_TMPFS_XATTR=y CONFIG_VETH=y CONFIG_BRIDGE=y CONFIG_NETFILTER=y CONFIG_BRIDGE_NETFILTER=y CONFIG_NETFILTER_ADVANCED=y CONFIG_NF_CONNTRACK=y CONFIG_IP_NF_IPTABLES=y CONFIG_IP_NF_FILTER=y CONFIG_IP_NF_NAT=y CONFIG_NF_NAT=y CONFIG_IP_NF_TARGET_MASQUERADE=y CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y CONFIG_NETFILTER_XT_TARGET_TCPMSS=y CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y CONFIG_NF_CONNTRACK_NETLINK=y CONFIG_NF_NAT_REDIRECT=y CONFIG_IP_ADVANCED_ROUTER=y CONFIG_IP_MULTIPLE_TABLES=y CONFIG_BPF=y CONFIG_BPF_SYSCALL=y CONFIG_DEBUG_FS=y CONFIG_KALLSYMS=y CONFIG_DEBUG_KERNEL=y CONFIG_PERF_EVENTS=y CONFIG_FTRACE=y CONFIG_KPROBES=y CONFIG_MAGIC_SYSRQ=y CONFIG_SCHED_DEBUG=y CONFIG_SCHEDSTATS=y CONFIG_LOCKDEP=y CONFIG_KVM=y CONFIG_VHOST_NET=y CONFIG_VIRTUALIZATION=y CONFIG_DRM_MSM=y CONFIG_MSM_KGSL=y CONFIG_CPU_FREQ=y CONFIG_CPU_FREQ_STAT=y CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y CONFIG_CPU_BOOST=y CONFIG_ADRENO_IDLER=y CONFIG_COMPAT=y"
EXTRA_CMDS="$EXTRA_CMDS CONFIG_BPF_JIT=n CONFIG_BPF_JIT_ALWAYS_ON=n"
